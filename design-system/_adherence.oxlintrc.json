{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/downloads/**",
              "components/forms/**",
              "ui_kits/app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Geist|Geist Mono))/i]",
        "message": "Font not provided by the design system. Available: Geist, Geist Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|disabled|onClick|children|title|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, disabled, onClick, children, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|destructive)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:elevation|glass|accent|padding|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: elevation, glass, accent, padding, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='elevation'] > Literal[value!=/^(?:card|panel)$/]",
        "message": "<Card> elevation must be one of 'card' | 'panel'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ClipboardBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:url|onConfirm|onDismiss|disabled|style|key|ref|className|style|children)$/]",
        "message": "<ClipboardBanner> doesn't accept that prop. Declared props: url, onConfirm, onDismiss, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DownloadItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|host|status|segments|progress|speedMBps|etaText|downloadedMB|totalMB|errorMessage|recoveryHint|statusLabel|on|style|key|ref|className|style|children)$/]",
        "message": "<DownloadItem> doesn't accept that prop. Declared props: title, host, status, segments, progress, speedMBps, etaText, downloadedMB, totalMB, errorMessage, recoveryHint, statusLabel, on, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DownloadItem'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:queued|downloading|paused|stalled|complete|error)$/]",
        "message": "<DownloadItem> status must be one of 'queued' | 'downloading' | 'paused' | 'stalled' | 'complete' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HistoryItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|path|sizeText|dateText|status|on|style|key|ref|className|style|children)$/]",
        "message": "<HistoryItem> doesn't accept that prop. Declared props: title, path, sizeText, dateText, status, on, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HistoryItem'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:complete|error)$/]",
        "message": "<HistoryItem> status must be one of 'complete' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|strokeWidth|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, strokeWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|size|iconSize|danger|title|onClick|disabled|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, size, iconSize, danger, title, onClick, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|error|mono|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: value, onChange, placeholder, error, mono, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|status|height|style|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, status, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:downloading|complete|paused|stalled|error|queued)$/]",
        "message": "<ProgressBar> status must be one of 'downloading' | 'complete' | 'paused' | 'stalled' | 'error' | 'queued'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:segments|count|status|height|gap|style|key|ref|className|style|children)$/]",
        "message": "<SegmentBar> doesn't accept that prop. Declared props: segments, count, status, height, gap, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentBar'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:downloading|complete|paused|stalled|error|queued)$/]",
        "message": "<SegmentBar> status must be one of 'downloading' | 'complete' | 'paused' | 'stalled' | 'error' | 'queued'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|label|width|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: options, value, onChange, label, width, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slider'] > JSXAttribute > JSXIdentifier[name!=/^(?:min|max|value|onChange|label|unit|width|style|key|ref|className|style|children)$/]",
        "message": "<Slider> doesn't accept that prop. Declared props: min, max, value, onChange, label, unit, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|unit|icon|hot|style|key|ref|className|style|children)$/]",
        "message": "<StatTile> doesn't accept that prop. Declared props: label, value, unit, icon, hot, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|label|style|key|ref|className|style|children)$/]",
        "message": "<StatusBadge> doesn't accept that prop. Declared props: status, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:queued|downloading|paused|stalled|complete|error|extracting)$/]",
        "message": "<StatusBadge> status must be one of 'queued' | 'downloading' | 'paused' | 'stalled' | 'complete' | 'error' | 'extracting'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Toggle> doesn't accept that prop. Declared props: checked, onChange, label, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='UrlBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|onDownload|onPaste|quality|onQualityChange|format|onFormatChange|extracting|error|style|key|ref|className|style|children)$/]",
        "message": "<UrlBar> doesn't accept that prop. Declared props: value, onChange, onDownload, onPaste, quality, onQualityChange, format, onFormatChange, extracting, error, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Button": {
        "replaces": []
