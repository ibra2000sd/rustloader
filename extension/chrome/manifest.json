{
  "manifest_version": 3,
  "name": "Rustloader Companion",
  "version": "0.2.0",
  "description": "Detect media on pages and send downloads to the Rustloader download manager running on this computer.",
  "permissions": ["contextMenus", "cookies", "storage", "webRequest"],
  "host_permissions": ["http://127.0.0.1/*", "<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Rustloader Companion",
    "default_popup": "popup.html"
  }
}
